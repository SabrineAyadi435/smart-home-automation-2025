<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ui.components.NotificationPanel"
      spacing="10"
      styleClass="notification-panel"
      minWidth="300"
      maxWidth="350"
      prefWidth="320">
    
    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10; -fx-background-color: #2c3e50;">
        <Label text="🔔 NOTIFICATIONS" style="-fx-text-fill: white; -fx-font-size: 14pt; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="notificationCount" text="(0)" style="-fx-text-fill: white; -fx-font-size: 12pt;"/>
        <Button fx:id="clearAllButton" text="Clear All" 
                style="-fx-font-size: 10pt; -fx-background-color: #34495e; -fx-text-fill: white; -fx-padding: 5 10;"/>
    </HBox>
    
    <!-- Notification List -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: #ecf0f1;" VBox.vgrow="ALWAYS">
        <ListView fx:id="notificationListView" 
                  style="-fx-background-color: transparent; -fx-border-color: transparent;"/>
    </ScrollPane>
    
</VBox>
